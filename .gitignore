# Ваги моделей. Двадцять гігабайтів, яким у репозиторії не місце
ollama-models/

# Справжні стенограми лекцій: імена викладачів і студентів
# У git не потрапляють ніколи
data/transcripts/

# Відповіді моделей: побудовані з тих самих стенограм, отже теж із іменами
out/

# Архіви попереднього, розвідувального проєкту
*.rar
*.tar.gz

# Службове
*.tmp
Thumbs.db
desktop.ini

# Аудіо лекцій: ті самі імена, тільки голосом
data/audio/

# Відео лекцій - те саме. Каталог з'явився 2026-09-25 і в .gitignore його
# не було: git add -A data забрав би півтора гігабайта голосів у історію.
data/video/

# Віртуальне середовище для розпізнавання мови
.venv/

# Кеш python
__pycache__/

# Обзор для себя, не для репозитория
docs/obzor.md

# Логи сесій у корені: там лежать уривки стенограм, отже імена.
# Досі трималися тільки в .git/info/exclude, а той файл не версіонується
# і при клоні зникає — тому правило перенесене сюди.
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
* outputs/

# Еталон вимог: там формулювання з пари, отже можливі імена.
# У git ідуть тільки ключі й мітки (data/requirement-map.tsv,
# data/precision-labels.tsv) - текст ніколи.
data/etalon/

# Робочі документи: план і ТЗ. У git не йдуть - там опис перебігу роботи,
# а не сама робота. Журнал рішень і README лишаються у git.
docs/plan.md
docs/tz-vazhlyve.md
